# Copy to .env.local. BOLNA_AGENT_ID must be a new Bharat Bank agent, not the CSS Quest one.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
UI_ACTION_TOKEN=replace-with-a-long-random-string

